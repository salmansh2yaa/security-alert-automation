        "jsCode": "// Map the incoming severity to a threat level\nconst body = $input.first().json.body || {};\nlet severity = (body.severity || '').toString().trim().toLowerCase();\n\n// Normalize common variations\nconst map = {\n  'critical': 'critical',\n  'crit': 'critical',\n  'high': 'high',\n  'medium': 'medium',\n  'med': 'medium',\n  'moderate': 'medium',\n  'low': 'low',\n  'info': 'low',\n  'informational': 'low'\n};\n\nlet text = map[severity] || 'medium';\n\nreturn [{ json: { text, body } }];"
      },
